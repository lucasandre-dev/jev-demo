# Única credencial necessária: serve tanto para o Jev quanto para o LLM
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo do Jev no OpenRouter (typesafe/jev-1.13 ou ~typesafe/jev-latest)
JEV_MODEL=typesafe/jev-1.13

# Modelos LLM exibidos no dropdown (separados por vírgula; o primeiro é o padrão)
LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-haiku-4.5,google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct
